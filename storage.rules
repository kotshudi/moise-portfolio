rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdministrator() {
      return request.auth != null && (
        request.auth.token.get('admin', false) == true ||
        (request.auth.token.email == 'mozartkats01@gmail.com' && request.auth.token.get('email_verified', false) == true)
      );
    }
    match /portfolio/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if isAdministrator() && request.auth.uid == userId
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isAdministrator() && request.auth.uid == userId;
    }
  }
}
