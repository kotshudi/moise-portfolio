rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdministrator() {
      return request.auth != null && (
        request.auth.token.get('admin', false) == true ||
        (request.auth.token.email == 'mozartkats01@gmail.com' &&
         request.auth.token.get('email_verified', false) == true)
      );
    }
    function isPortfolioSection(section) {
      return section in ['profile', 'biography', 'career', 'education', 'projects', 'skills', 'media', 'settings'];
    }
    match /{section}/main {
      allow read: if isPortfolioSection(section);
      allow create, update: if isPortfolioSection(section) && isAdministrator()
        && request.resource.data.revision is int && request.resource.data.revision > 0;
      allow delete: if false;
    }
    match /cmsBackups/{backup} {
      allow read, create: if isAdministrator();
      allow update, delete: if false;
    }
  }
}
